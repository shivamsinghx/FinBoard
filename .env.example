# Copy to .env.local and fill in. Server-only (no NEXT_PUBLIC_ prefix):
# /api/proxy injects these into upstream requests, so keys never reach the browser.

# Finnhub — https://finnhub.io/dashboard (added as ?token= on finnhub.io URLs)
FINNHUB_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key (added as ?apikey= on alphavantage.co URLs)
ALPHA_VANTAGE_API_KEY=
